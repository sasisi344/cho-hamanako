---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"affiliates">["data"];
}

const { product } = Astro.props;

// SiteStripe 等の HTML しかない場合は href を取り出す（AffiliateCard / BannerCard と同じ扱い）
let finalLink = product.link;
if (product.html) {
  const linkMatch = product.html.match(/href="([^"]+)"/);
  if (linkMatch) finalLink = linkMatch[1];
}

// テキストリンク（A8.net / ValueCommerce MyLink 等）の image はインプレッション計測用の画像として扱い、1x1 で出力する
const impressionPixel = product.image || undefined;
---

{finalLink && (
  <p class="not-prose my-4 px-4 py-3 rounded-lg border-l-4 border-orange-400 bg-orange-50/60 dark:bg-orange-900/10 text-sm leading-relaxed">
    <a
      href={finalLink}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="font-bold text-blue-600 dark:text-blue-400 underline underline-offset-2 hover:no-underline affiliate-link"
      data-aff-id={product.id}
      data-aff-brand={product.brand ?? ""}
      data-aff-name={product.name}
    >
      {product.name}
    </a>
    {product.description && (
      <span class="block mt-1 text-slate-600 dark:text-slate-400">{product.description}</span>
    )}
    {impressionPixel && <img src={impressionPixel} width="1" height="1" alt="" loading="lazy" class="inline border-0" />}
  </p>
)}
