---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import { blogPostHref, withTrailingSlash } from "@lib/paths";

interface Props {
  slug?: string;
  url?: string;
  title?: string;
  summary?: string;
  cover?: ImageMetadata | string;
}

const { slug, url, title, summary, cover } = Astro.props;
const entry = slug ? await getEntry("blog", slug) : null;

const finalUrl = url
  ? (url.startsWith("http") ? url : withTrailingSlash(url))
  : entry
    ? blogPostHref(entry.slug, entry.data.category)
    : "#";
const finalTitle = title || (entry ? entry.data.title : "Link");
const finalSummary = summary || (entry ? entry.data.summary : "");
const finalCover = cover || (entry ? entry.data.cover : null);
const isExternal = url?.startsWith('http');
---

{(entry || url) ? (
  <a href={finalUrl} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} class="not-prose related-card">
    <div class="related-card-content">
      <span class="related-card-label">{isExternal ? "外部リンク" : "関連記事"}</span>
      <div class="related-card-title line-clamp-2">{finalTitle}</div>
      {finalSummary && <div class="related-card-summary line-clamp-2">{finalSummary}</div>}
    </div>
    {finalCover && <div class="related-card-image">
      {typeof finalCover === "string"
        ? <img src={finalCover} alt="" width="240" height="160" loading="lazy" decoding="async" />
        : <Image src={finalCover} alt="" widths={[240, 400]} sizes="138px" format="webp" quality={75} loading="lazy" decoding="async" />}
    </div>}
    <span class="related-card-arrow" aria-hidden="true">↗</span>
  </a>
) : (
  <div class="my-6 p-4 border border-red-500/30 bg-red-500/10 rounded text-red-700 text-sm">⚠️ Blog entry "{slug}" not found.</div>
)}
