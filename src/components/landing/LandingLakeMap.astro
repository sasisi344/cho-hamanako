---

<div class="lake-map">
  <svg viewBox="0 0 1024 680" role="group" aria-labelledby="lake-map-title lake-map-description">
    <title id="lake-map-title">浜名湖のエリアマップ</title>
    <desc id="lake-map-description">北から奥浜名湖、中浜名湖、表浜名湖。各エリアを選ぶと釣り場マップへ移動します。位置関係を示す概略図です。</desc>
    <defs><clipPath id="landing-lake-clip"><path d={lakeOutline} /></clipPath></defs>
    <rect width="1024" height="680" fill="#e7f3f1" />
    <g fill="none" stroke="#b7c8c6" stroke-width="2">
      <path d="M0 318C137 314 165 348 236 365S261 438 293 466 355 489 367 548 443 605 492 605 600 590 675 610 880 620 1024 632" />
      <path d="M240 0C280 61 333 83 331 155S300 246 286 280 257 312 236 365 199 471 180 555 163 620 132 680" />
      <path d="M517 0C512 63 539 103 598 126S710 126 785 194 867 278 885 343 931 387 1024 418" />
      <path d="M1024 250C890 224 842 255 800 336S747 455 708 478 677 535 676 610L695 680M0 540C136 531 211 542 285 570S353 610 418 610" />
    </g>
    <path d="M0 660C196 625 308 641 420 651S576 665 668 651 855 652 1024 666V680H0Z" fill="#92ced1" />
    <g clip-path="url(#landing-lake-clip)">
      <a href={mapHref("奥浜名湖")} aria-label="奥浜名湖の釣り場を探す" class="map-region">
        <rect x="0" y="0" width="1024" height="315" fill="#399da5" />
        <text x="510" y="263">奥浜名湖</text>
      </a>
      <a href={mapHref("中浜名湖")} aria-label="中浜名湖の釣り場を探す" class="map-region">
        <rect x="0" y="315" width="1024" height="178" fill="#5db4bb" />
        <text x="467" y="414">中浜名湖</text>
      </a>
      <a href={mapHref("表浜名湖")} aria-label="表浜名湖の釣り場を探す" class="map-region">
        <rect x="0" y="493" width="1024" height="187" fill="#84cbd0" />
        <text x="523" y="580">表浜名湖</text>
      </a>
      <path d="M160 315H820M220 493H750" fill="none" stroke="#f4ffff" stroke-width="2" />
    </g>
    <path d={lakeOutline} fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" pointer-events="none" />
  </svg>
</div>
