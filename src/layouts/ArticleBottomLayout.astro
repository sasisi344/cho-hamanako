---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content } = await entry.render()

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const items = collection === "blog" ? posts : projects
const index = items.findIndex(x => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]

const getHref = (e: (typeof items)[number]) =>
  e.collection === "blog"
    ? blogPostHref(e.slug, e.data.category)
    : `/${e.collection}/${e.slug}/`
import { ADSENSE } from "@consts"
import { blogPostHref } from "@lib/paths"

const isBlog = collection === "blog"
---

<div>
  <article id="article" data-category={entry.collection === "blog" ? entry.data.category : entry.collection}>
    <Content/>
  </article>

  {isBlog && (
    <div class="my-12 animate adsense-multiplex">
       <ins class="adsbygoogle"
            style="display:block"
            data-ad-format="autorelaxed"
            data-ad-client={ADSENSE.CLIENT_ID}
            data-ad-slot={ADSENSE.MULTIPLEX_SLOT}></ins>
       <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )}

  {isBlog && (
    <script is:inline define:vars={{ ADSENSE }}>
      function injectRectangleAd() {
        const article = document.getElementById("article");
        const firstH2 = article?.querySelector("h2");
        if (firstH2 && !article.querySelector(".adsense-rectangle")) {
          const adContainer = document.createElement("div");
          adContainer.className = "my-8 flex justify-center adsense-rectangle";
          // flex の子は幅が 0 に縮み、AdSense が埋めないので width:100% を付ける
          adContainer.innerHTML = `
            <ins class="adsbygoogle"
                 style="display:block;width:100%"
                 data-ad-client="${ADSENSE.CLIENT_ID}"
                 data-ad-slot="${ADSENSE.RECTANGLE_SLOT}"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
          `;
          firstH2.insertAdjacentElement("afterend", adContainer);
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
        injectInArticleAds(article);
      }

      // 記事の途中（3つ目ごとの H2 の前、最大2枠）と、最後の H2 の前に広告を入れる（hq:H-41）
      function injectInArticleAds(article) {
        if (!article || article.querySelector(".adsense-in-article")) return;
        const h2s = Array.from(article.querySelectorAll("h2"));
        // アフィリエイトのカードの直後には置かない
        const afterCard = (h2) => {
          const prev = h2.previousElementSibling;
          return !!prev && (prev.matches("[data-aff-position]") || !!prev.querySelector(".affiliate-link"));
        };
        const targets = [];
        for (let i = 3; i < h2s.length - 1 && targets.length < 2; i++) {
          const last = targets[targets.length - 1];
          if ((last === undefined || i - last >= 3) && !afterCard(h2s[i])) targets.push(i);
        }
        const lastIndex = h2s.length - 1;
        const prevTarget = targets[targets.length - 1];
        if (lastIndex >= 2 && (prevTarget === undefined || lastIndex - prevTarget >= 2) && !afterCard(h2s[lastIndex])) {
          targets.push(lastIndex);
        }
        for (const i of targets) {
          const slot = i === lastIndex ? ADSENSE.IN_ARTICLE_END_SLOT : ADSENSE.IN_ARTICLE_MID_SLOT;
          const adContainer = document.createElement("div");
          adContainer.className = "my-8 adsense-in-article";
          adContainer.innerHTML = `
            <ins class="adsbygoogle"
                 style="display:block; text-align:center;"
                 data-ad-layout="in-article"
                 data-ad-format="fluid"
                 data-ad-client="${ADSENSE.CLIENT_ID}"
                 data-ad-slot="${slot}"></ins>
          `;
          h2s[i].insertAdjacentElement("beforebegin", adContainer);
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
      }

      // 実行
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", injectRectangleAd);
      } else {
        injectRectangleAd();
      }

      // Astro ViewTransitions 対応
      document.addEventListener("astro:page-load", injectRectangleAd);
    </script>
  )}
  <nav class="article-pagination" aria-label="前後の記事">
    <a href={getHref(prev)}><span aria-hidden="true">←</span><span><span class="pagination-label">前の記事</span>{prev.data.title}</span></a>
    <a href={getHref(next)}><span><span class="pagination-label">次の記事</span>{next.data.title}</span><span aria-hidden="true">→</span></a>
  </nav>
</div>
