---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"
import { BLOG, POINTS } from "@consts"

import { Image } from "astro:assets"

type Props = {
  entry: CollectionEntry<"projects"> | CollectionEntry<"blog">
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary } = data
const cover = 'cover' in data ? data.cover : null

const date = collection === "blog" ? data.pubDate : data.date
const upDate = collection === "blog" ? data.upDate : null

const demoUrl = collection === "projects" ? data.demoUrl : null
const repoUrl = collection === "projects" ? data.repoUrl : null

const backLink =
  collection === "blog" && "category" in data && data.category === "points"
    ? { href: "/points/", label: `${POINTS.TITLE}へ戻る` }
    : collection === "blog"
      ? { href: "/blog/", label: `${BLOG.TITLE}へ戻る` }
      : { href: `/${collection}/`, label: `${collection}へ戻る` }
---

<div class="article-heading">
  <a href={backLink.href} class="article-back"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6" /></svg>{backLink.label}</a>
  <div class="article-meta">
    <span><svg aria-hidden="true"><use href="/ui.svg#calendar" /></svg><time datetime={date.toISOString()}>{formatDate(date)}</time></span>
    {upDate && <span>更新 <time datetime={upDate.toISOString()}>{formatDate(upDate)}</time></span>}
    <span><svg aria-hidden="true"><use href="/ui.svg#book-open" /></svg>{readingTime(body)}</span>
  </div>
  <h1 id="article-title">{title}</h1>
  <div class="article-summary">{summary}</div>
  {cover && <div class="article-cover"><Image src={cover} alt={title} widths={[480, 860, 1200]} sizes="(max-width: 900px) calc(100vw - 40px), 860px" format="webp" quality={80} loading="eager" decoding="async" /></div>}
  {(demoUrl || repoUrl) && <div class="mt-6 flex flex-wrap gap-4">
    {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer">デモを見る ↗</a>}
    {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer">リポジトリを見る ↗</a>}
  </div>}
</div>
