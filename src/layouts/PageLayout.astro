---
import LandingLayout from "@layouts/LandingLayout.astro"
const {
  title,
  description,
  noindex,
  hasAds = false,
  image,
  ogType = "website",
  jsonLdExtra,
} = Astro.props
const pathname = Astro.url.pathname
const pageKind = ogType === "article" ? "article" : pathname.startsWith("/legal/") ? "document"
  : pathname.startsWith("/map/") ? "map" : pathname.startsWith("/affiliates/") ? "gear" : "collection"
---

<LandingLayout title={title} description={description} noindex={noindex} hasAds={hasAds} image={image} ogType={ogType} jsonLdExtra={jsonLdExtra} interior pageKind={pageKind}>
  <slot />
</LandingLayout>
