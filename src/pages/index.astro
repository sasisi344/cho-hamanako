---
import { Image, getImage } from "astro:assets"
import LandingLayout from "@layouts/LandingLayout.astro"
import LandingLakeMap from "@components/landing/LandingLakeMap.astro"
import heroImage from "../assets/landing/hero.webp"
import mobileHeroImage from "../assets/landing/hero-mobile.webp"
import spotsImage from "../assets/landing/journal-spots.webp"
import fishImage from "../assets/landing/journal-fish.webp"
import beginnerImage from "../assets/landing/journal-beginner.webp"

const title = "浜名湖釣りガイド｜釣り場・魚・はじめての浜名湖釣り"
const description = "浜名湖の釣りを、もっと深く。表浜名湖・中浜名湖・奥浜名湖の釣り場マップ、魚から探す釣り方、道具選びやマナーまで。浜名湖の釣りを楽しむための総合ガイドです。"
const areas = ["表浜名湖", "中浜名湖", "奥浜名湖"]
const journal = [
  { category: "釣り場", title: "釣り場の選び方", href: "/map/", image: spotsImage, alt: "夕日に照らされた湖畔で釣りをする人のイメージ" },
  { category: "魚と釣り方", title: "魚から釣り方を探す", href: "/blog/target/", image: fishImage, alt: "青緑の水中を泳ぐシーバスのイメージ" },
  { category: "入門ガイド", title: "はじめての浜名湖釣り", href: "/blog/guide/", image: beginnerImage, alt: "水辺に並べた釣り竿とリール、ルアーのイメージ" },
]
const heroWidths = [750, 1100, 1440, 1672]
const heroSources = await Promise.all(heroWidths.map(width => getImage({ src: heroImage, width, format: "webp", quality: 84 })))
const heroSrcset = heroSources.map((image, i) => `${image.src} ${heroWidths[i]}w`).join(", ")
const hero = heroSources[2]
const mobileWidths = [480, 750, 1122]
const mobileSources = await Promise.all(mobileWidths.map(width => getImage({ src: mobileHeroImage, width, format: "webp", quality: 84 })))
const mobileSrcset = mobileSources.map((image, i) => `${image.src} ${mobileWidths[i]}w`).join(", ")
---

<LandingLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={hero.src} imagesrcset={heroSrcset} imagesizes="100vw" media="(min-width: 601px)" fetchpriority="high" />
    <link rel="preload" as="image" href={mobileSources[1].src} imagesrcset={mobileSrcset} imagesizes="100vw" media="(max-width: 600px)" fetchpriority="high" />
  </Fragment>
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-picture">
      <source media="(max-width: 600px)" srcset={mobileSrcset} sizes="100vw" width={mobileHeroImage.width} height={mobileHeroImage.height} />
      <img class="hero-scene" src={hero.src} srcset={heroSrcset} sizes="100vw" width={heroImage.width} height={heroImage.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content landing-shell">
      <p class="eyebrow hero-eyebrow" lang="en">LAKE HAMANA FISHING GUIDE<span aria-hidden="true"></span></p>
      <h1 id="hero-title">浜名湖の釣りを、<br />もっと深く。</h1>
      <p class="hero-description">釣り場も、魚も、楽しみ方も。</p>
      <div class="hero-actions">
        <a href="/map/" class="coral-button">釣り場を探す<span aria-hidden="true">→</span></a>
        <a href="/blog/guide/" class="text-link">はじめての浜名湖<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <a href="#explore" class="scroll-cue" aria-label="エリアから釣り場を探すセクションへ">
      <span lang="en">SCROLL</span><span class="scroll-line" aria-hidden="true">↓</span>
    </a>
  </section>

  <div class="ocean-content">
    <section id="explore" class="explore landing-shell" aria-labelledby="explore-title">
      <div class="explore-copy">
        <p class="eyebrow" lang="en">EXPLORE THE LAKE<span aria-hidden="true"></span></p>
        <h2 id="explore-title">エリアから探す</h2>
        <p class="section-description">表・中・奥。それぞれの浜名湖へ。</p>
        <nav class="area-links" aria-label="浜名湖のエリア">
          {areas.map(area => <a href={`/map/?area=${encodeURIComponent(area)}`}><span>{area}</span><span class="area-arrow" aria-hidden="true">→</span></a>)}
        </nav>
      </div>
      <div class="explore-map">
        <LandingLakeMap />
        <div class="map-caption"><span>エリアの位置を示した概略図</span><a class="text-link" href="/map/">釣り場マップを開く<span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="journal landing-shell" aria-labelledby="journal-title">
      <p class="eyebrow" lang="en">FISHING JOURNAL<span aria-hidden="true"></span></p>
      <h2 id="journal-title">浜名湖を楽しむヒント</h2>
      <div class="journal-grid">
        {journal.map(item => (
          <a class="journal-card" href={item.href}>
            <div class="journal-image"><Image src={item.image} alt={item.alt} widths={[400, 640, 800]} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) calc((100vw - 96px) / 2), 400px" format="webp" quality={82} loading="lazy" decoding="async" /></div>
            <p class="journal-category">{item.category}</p>
            <h3>{item.title}<span class="card-arrow" aria-hidden="true">↗</span></h3>
          </a>
        ))}
      </div>
    </section>

    <section class="beginner landing-shell" aria-labelledby="beginner-title">
      <div class="beginner-panel">
        <img src={heroSources[1].src} class="beginner-scene" alt="" width={1100} height={Math.round(heroImage.height * 1100 / heroImage.width)} loading="lazy" decoding="async" />
        <div class="beginner-copy"><h2 id="beginner-title">最初の一投を、浜名湖で。</h2><p>道具選びから釣り場のマナーまで。</p></div>
        <a href="/blog/guide/" class="coral-button">釣りの基本を読む<span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</LandingLayout>
